@model PennyWise.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Profilim";
}

<div class="space-y-6 max-w-2xl mx-auto">
    <div>
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Profilim</h2>
        <p class="text-slate-500 text-sm mt-1">Hesap bilgileriniz ve finansal özetiniz.</p>
    </div>

    <!-- Profil Kartı -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="bg-slate-900 px-8 py-6 flex items-center gap-5">
            <div class="w-16 h-16 rounded-2xl bg-emerald-500 flex items-center justify-center text-white text-2xl font-bold shadow-lg shadow-emerald-500/30">
                @(Model.Email.Substring(0, 2).ToUpper())
            </div>
            <div>
                <h3 class="text-xl font-bold text-white">@Model.UserName</h3>
                <p class="text-slate-400 text-sm">@Model.Email</p>
            </div>
        </div>

        <div class="p-8 grid grid-cols-3 gap-6">
            <div class="text-center p-4 bg-slate-50 rounded-xl">
                <div class="text-2xl font-bold text-slate-800">@Model.TransactionCount</div>
                <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Toplam İşlem</div>
            </div>
            <div class="text-center p-4 bg-emerald-50 rounded-xl">
                <div class="text-2xl font-bold text-emerald-600">@Model.TotalIncome.ToString("N0") ₺</div>
                <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Toplam Gelir</div>
            </div>
            <div class="text-center p-4 bg-rose-50 rounded-xl">
                <div class="text-2xl font-bold text-rose-500">@Model.TotalExpense.ToString("N0") ₺</div>
                <div class="text-xs text-slate-400 uppercase tracking-wider mt-1">Toplam Gider</div>
            </div>
        </div>

        <div class="px-8 pb-8">
            <div class="border-t border-slate-100 pt-6 flex items-center justify-between">
                <div>
                    <p class="text-sm font-semibold text-slate-700">Net Bakiye</p>
                    <p class="text-3xl font-bold @(Model.Balance >= 0 ? "text-emerald-600" : "text-rose-500") mt-1">
                        @Model.Balance.ToString("N2") ₺
                    </p>
                </div>
                <a asp-action="ChangePassword"
                   class="bg-slate-900 hover:bg-slate-700 text-white px-5 py-2.5 rounded-xl font-semibold text-sm transition flex items-center gap-2">
                    <i class="fa-solid fa-key"></i> Şifre Değiştir
                </a>
            </div>
        </div>
    </div>
</div>
