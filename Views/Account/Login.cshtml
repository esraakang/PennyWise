@model PennyWise.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Giriş Yap";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>PennyWise – Giriş</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"/>
</head>
<body class="bg-slate-900 min-h-screen flex items-center justify-center">
<div class="w-full max-w-md mx-4">
    <div class="text-center mb-8">
        <div class="inline-flex items-center gap-3">
            <div class="p-3 bg-emerald-500 rounded-xl text-white shadow-lg shadow-emerald-500/30">
                <i class="fa-solid fa-wallet text-3xl"></i>
            </div>
            <div class="text-left">
                <h1 class="font-bold text-2xl text-white">PennyWise</h1>
                <span class="text-xs text-emerald-400 font-semibold tracking-widest uppercase">Pro Edition</span>
            </div>
        </div>
    </div>

    <div class="bg-white rounded-2xl shadow-2xl overflow-hidden">
        <div class="p-8">
            <h2 class="text-2xl font-bold text-slate-800 mb-1">Hoş Geldiniz</h2>
            <p class="text-slate-500 text-sm mb-6">Hesabınıza giriş yapın.</p>

            <form asp-action="Login" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ReturnUrl" value="@ViewBag.ReturnUrl"/>

                <div asp-validation-summary="All" class="mb-4 bg-rose-50 border border-rose-200 text-rose-600 rounded-lg p-3 text-sm"></div>

                <div class="mb-4">
                    <label asp-for="Email" class="block text-sm font-bold text-slate-700 mb-1"></label>
                    <input asp-for="Email" type="email" placeholder="ornek@mail.com"
                           class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                    <span asp-validation-for="Email" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Password" class="block text-sm font-bold text-slate-700 mb-1"></label>
                    <input asp-for="Password" type="password" placeholder="••••••••"
                           class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                    <span asp-validation-for="Password" class="text-rose-500 text-xs mt-1 block"></span>
                </div>

                <div class="mb-6 flex items-center gap-2">
                    <input asp-for="RememberMe" type="checkbox" class="rounded"/>
                    <label asp-for="RememberMe" class="text-sm text-slate-600"></label>
                </div>

                <button type="submit"
                        class="w-full bg-emerald-500 hover:bg-emerald-600 text-white py-2.5 rounded-lg font-bold text-sm transition shadow-md shadow-emerald-500/20">
                    Giriş Yap
                </button>
            </form>
        </div>
        <div class="px-8 py-4 bg-slate-50 border-t border-slate-100 text-center">
            <p class="text-sm text-slate-500">
                Hesabınız yok mu?
                <a asp-action="Register" asp-controller="Account" class="text-emerald-600 font-semibold hover:text-emerald-700">Kayıt Ol</a>
            </p>
        </div>
    </div>
</div>
</body>
</html>
