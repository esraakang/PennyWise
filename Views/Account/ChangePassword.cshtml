@model PennyWise.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Şifre Değiştir";
}

<div class="max-w-md mx-auto">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Şifre Değiştir</h2>
        <p class="text-slate-500 text-sm mt-1">Güvenliğiniz için güçlü bir şifre belirleyin.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <form asp-action="ChangePassword" method="post" class="p-8 space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="bg-rose-50 border border-rose-200 text-rose-600 rounded-lg p-3 text-sm"></div>

            <div>
                <label asp-for="CurrentPassword" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="CurrentPassword" type="password" placeholder="Mevcut şifreniz"
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="CurrentPassword" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="NewPassword" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="NewPassword" type="password" placeholder="Yeni şifreniz (min. 6 karakter)"
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="NewPassword" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="ConfirmPassword" type="password" placeholder="Yeni şifreyi tekrar girin"
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="ConfirmPassword" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white py-2.5 rounded-lg font-bold text-sm transition">
                    Şifreyi Güncelle
                </button>
                <a asp-action="Profile"
                   class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg font-bold text-sm transition">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>
