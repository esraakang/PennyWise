@model PennyWise.ViewModels.TransactionListViewModel
@{
    ViewData["Title"] = "İşlem Defteri";
}

<div class="space-y-6">
    <div>
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">İşlem Defteri</h2>
        <p class="text-slate-500 text-sm mt-1">Kayıtlı tüm gelir ve giderlerinizi yönetin.</p>
    </div>

    <!-- Filtreler -->
    <form method="get" asp-action="Index">
        <div class="bg-white p-4 rounded-xl border border-slate-100 shadow-sm flex flex-col md:flex-row gap-4 items-center justify-between">
            <div class="relative w-full md:w-80">
                <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-slate-400">
                    <i class="fa-solid fa-magnifying-glass"></i>
                </span>
                <input type="text" name="search" value="@Model.SearchTerm" placeholder="Açıklama ara..."
                       class="w-full pl-10 pr-4 py-2 border border-slate-200 rounded-lg text-sm outline-none focus:border-slate-400 transition"/>
            </div>
            <div class="flex flex-wrap gap-2 w-full md:w-auto">
                <select name="type" class="border border-slate-200 rounded-lg px-3 py-2 text-sm outline-none bg-white">
                    <option value="">Tüm Tipler</option>
                    @if (Model.FilterType == PennyWise.Models.TransactionType.Gelir)
                    {
                        <option value="Gelir" selected>Gelirler</option>
                    }
                    else
                    {
                        <option value="Gelir">Gelirler</option>
                    }
                    @if (Model.FilterType == PennyWise.Models.TransactionType.Gider)
                    {
                        <option value="Gider" selected>Giderler</option>
                    }
                    else
                    {
                        <option value="Gider">Giderler</option>
                    }
                </select>
                <select name="catId" class="border border-slate-200 rounded-lg px-3 py-2 text-sm outline-none bg-white">
                    <option value="">Tüm Kategoriler</option>
                    @if (Model.Categories != null)
                    {
                        @foreach (var item in Model.Categories)
                        {
                            if (Model.FilterCatId?.ToString() == item.Value)
                            {
                                <option value="@item.Value" selected>@item.Text</option>
                            }
                            else
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        }
                    }
                </select>
                <button type="submit" class="bg-emerald-500 hover:bg-emerald-600 text-white px-4 py-2 rounded-lg text-sm font-semibold transition">
                    Filtrele
                </button>
                <a asp-action="Index" class="text-slate-500 hover:text-slate-800 text-sm px-3 py-2 font-medium">Temizle</a>
            </div>
        </div>
    </form>

    <!-- Yeni İşlem Butonu -->
    <div class="flex justify-end">
        <a asp-action="Create" class="bg-emerald-500 hover:bg-emerald-600 text-white px-5 py-2.5 rounded-lg font-semibold shadow-md transition flex items-center gap-2 text-sm">
            <i class="fa-solid fa-plus"></i> Yeni İşlem
        </a>
    </div>

    <!-- Tablo -->
    <div class="bg-white rounded-xl border border-slate-100 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-slate-50 border-b border-slate-100 text-slate-500 text-xs font-bold uppercase">
                        <th class="p-4">Açıklama</th>
                        <th class="p-4">Kategori</th>
                        <th class="p-4">Tür</th>
                        <th class="p-4">Tarih</th>
                        <th class="p-4 text-right">Tutar</th>
                        <th class="p-4 text-center">Sil</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100 text-sm">
                    @foreach (var t in Model.Transactions)
                    {
                        <tr class="hover:bg-slate-50/50 transition">
                            <td class="p-4 font-semibold text-slate-800">@t.Description</td>
                            <td class="p-4">
                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-semibold text-white"
                                      style="background-color: @(t.Category?.Color ?? "#64748b")">
                                    <i class="fa-solid @(t.Category?.Icon ?? "fa-tag") text-[10px]"></i>
                                    @(t.Category?.Name ?? "–")
                                </span>
                            </td>
                            <td class="p-4">
                                <span class="text-xs font-bold px-2 py-1 rounded-full @(t.Type == PennyWise.Models.TransactionType.Gelir ? "bg-emerald-100 text-emerald-700" : "bg-rose-100 text-rose-700")">
                                    @t.Type
                                </span>
                            </td>
                            <td class="p-4 text-slate-500 text-xs">@t.TransactionDate.ToString("dd.MM.yyyy")</td>
                            <td class="p-4 text-right font-bold @(t.Type == PennyWise.Models.TransactionType.Gelir ? "text-emerald-500" : "text-rose-500")">
                                @(t.Type == PennyWise.Models.TransactionType.Gelir ? "+" : "-")@t.Amount.ToString("N2") ₺
                            </td>
                            <td class="p-4 text-center">
                                <form asp-action="Delete" method="post" onsubmit="return confirm('Bu işlemi silmek istediğinize emin misiniz?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@t.Id"/>
                                    <button type="submit" class="text-rose-500 hover:text-rose-700 p-1.5 hover:bg-rose-50 rounded-lg transition">
                                        <i class="fa-solid fa-trash-can"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Transactions.Any())
                    {
                        <tr><td colspan="6" class="p-8 text-center text-slate-400">Kayıt bulunamadı.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
