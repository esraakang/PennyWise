@model PennyWise.ViewModels.TransactionCreateViewModel
@{
    ViewData["Title"] = "Yeni İşlem";
}

<div class="max-w-lg mx-auto">
    <div class="mb-6">
        <h2 class="text-3xl font-bold text-slate-900 tracking-tight">Yeni İşlem Ekle</h2>
        <p class="text-slate-500 text-sm mt-1">Gelir veya gider kaydı oluşturun.</p>
    </div>

    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
        <form asp-action="Create" method="post" class="p-8 space-y-5">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="bg-rose-50 border border-rose-200 text-rose-600 rounded-lg p-3 text-sm"></div>

            <div>
                <label asp-for="Description" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="Description" placeholder="Örn: Market harcaması, Maaş..."
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="Description" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Type" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <select asp-for="Type" asp-items="Html.GetEnumSelectList<PennyWise.Models.TransactionType>()"
                        class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm bg-white">
                </select>
                <span asp-validation-for="Type" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="CategoryId" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <select asp-for="CategoryId" asp-items="Model.Categories"
                        class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm bg-white">
                    <option value="">Kategori seçiniz...</option>
                </select>
                <span asp-validation-for="CategoryId" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="Amount" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="Amount" type="number" step="0.01" min="0.01" placeholder="0.00"
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="Amount" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div>
                <label asp-for="TransactionDate" class="block text-sm font-bold text-slate-700 mb-1"></label>
                <input asp-for="TransactionDate" type="date"
                       class="w-full px-3 py-2.5 border border-slate-200 rounded-lg outline-none focus:border-emerald-400 text-sm transition"/>
                <span asp-validation-for="TransactionDate" class="text-rose-500 text-xs mt-1 block"></span>
            </div>

            <div class="flex gap-3 pt-2">
                <button type="submit"
                        class="flex-1 bg-emerald-500 hover:bg-emerald-600 text-white py-2.5 rounded-lg font-bold text-sm transition">
                    Kaydet
                </button>
                <a asp-action="Index" class="flex-1 text-center bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-lg font-bold text-sm transition">
                    İptal
                </a>
            </div>
        </form>
    </div>
</div>
