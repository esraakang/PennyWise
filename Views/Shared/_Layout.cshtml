<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – PennyWise</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        ::-webkit-scrollbar { width:6px; height:6px; }
        ::-webkit-scrollbar-track { background:#f1f5f9; }
        ::-webkit-scrollbar-thumb { background:#cbd5e1; border-radius:4px; }
        ::-webkit-scrollbar-thumb:hover { background:#94a3b8; }
    </style>
</head>
<body class="bg-slate-50 text-slate-800 font-sans min-h-screen">

<div class="flex flex-col md:flex-row min-h-screen">

    <!-- SOL MENÜ -->
    <aside class="w-full md:w-64 bg-slate-900 text-slate-100 flex flex-col justify-between p-6">
        <div>
            <div class="flex items-center gap-3 mb-8">
                <div class="p-2.5 bg-emerald-500 rounded-xl text-white shadow-lg shadow-emerald-500/30">
                    <i class="fa-solid fa-wallet text-2xl"></i>
                </div>
                <div>
                    <h1 class="font-bold text-xl tracking-wider">PennyWise</h1>
                    <span class="text-xs text-emerald-400 font-semibold tracking-widest uppercase">Pro Edition</span>
                </div>
            </div>

            <nav class="space-y-1">
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Admin" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "bg-slate-800 text-white font-medium" : "")">
                        <i class="fa-solid fa-shield-halved w-5"></i> Admin Paneli
                    </a>
                    <a asp-controller="Admin" asp-action="AllTransactions"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition @(ViewContext.RouteData.Values["action"]?.ToString() == "AllTransactions" ? "bg-slate-800 text-white font-medium" : "")">
                        <i class="fa-solid fa-list-check w-5"></i> Tüm İşlemler
                    </a>
                }
                else
                {
                    <a asp-controller="Dashboard" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "bg-slate-800 text-white font-medium" : "")">
                        <i class="fa-solid fa-chart-pie w-5"></i> Dashboard
                    </a>
                    <a asp-controller="Transaction" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Transaction" ? "bg-slate-800 text-white font-medium" : "")">
                        <i class="fa-solid fa-list-check w-5"></i> İşlemler
                    </a>
                    <a asp-controller="Budget" asp-action="Index"
                       class="w-full flex items-center gap-3 px-4 py-3 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white transition @(ViewContext.RouteData.Values["controller"]?.ToString() == "Budget" ? "bg-slate-800 text-white font-medium" : "")">
                        <i class="fa-solid fa-bullseye w-5"></i> Limitler & Hedefler
                    </a>
                }
            </nav>
        </div>

        <!-- Kullanıcı Bilgisi + Bakiye + Çıkış -->
        <div class="pt-6 border-t border-slate-800 space-y-3">
            @if (User.Identity?.IsAuthenticated == true)
            {
                <!-- HEADER'DA DİNAMİK BAKİYE (hoca şartı) -->
                @if (ViewBag.CurrentBalance != null)
                {
                    decimal bal = (decimal)ViewBag.CurrentBalance;
                    <div class="bg-slate-800 rounded-xl px-4 py-3 text-center">
                        <span class="text-xs text-slate-400 block">Kalan Bakiye</span>
                        <span class="text-lg font-bold @(bal >= 0 ? "text-emerald-400" : "text-rose-400")">
                            @bal.ToString("N2") ₺
                        </span>
                    </div>
                }
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-emerald-500 flex items-center justify-center text-white font-bold text-sm">
                        @(User.Identity.Name?.Substring(0, 2).ToUpper() ?? "KA")
                    </div>
                    <div class="flex-1 min-w-0">
                        <a asp-controller="Account" asp-action="Profile"
                           class="text-sm font-semibold text-slate-200 truncate hover:text-emerald-400 transition block">
                            @User.Identity.Name
                        </a>
                        <span class="text-xs text-slate-400">@(User.IsInRole("Admin") ? "Admin" : "Kullanıcı")</span>
                    </div>
                    <form asp-controller="Account" asp-action="Logout" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-slate-400 hover:text-rose-400 transition" title="Çıkış">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        </button>
                    </form>
                </div>
            }
        </div>
    </aside>

    <!-- SAĞ ANA İÇERİK -->
    <main class="flex-1 p-6 md:p-10 overflow-y-auto max-h-screen">

        <!-- Bildirimler -->
        @if (TempData["Success"] != null)
        {
            <div class="mb-4 bg-emerald-50 border border-emerald-200 text-emerald-700 px-4 py-3 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-circle-check"></i> @TempData["Success"]
            </div>
        }
        @if (TempData["Warning"] != null)
        {
            <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-700 px-4 py-3 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-triangle-exclamation"></i> @TempData["Warning"]
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="mb-4 bg-rose-50 border border-rose-200 text-rose-700 px-4 py-3 rounded-xl flex items-center gap-2">
                <i class="fa-solid fa-circle-xmark"></i> @TempData["Error"]
            </div>
        }

        @RenderBody()
    </main>
</div>

@RenderSection("Scripts", required: false)
</body>
</html>
